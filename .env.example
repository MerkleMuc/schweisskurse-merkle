# Öffentliche Basis-URL (ohne Schrägstrich am Ende)
NEXT_PUBLIC_SITE_URL=https://www.schweisskurse-merkle.de

# Datenbank (Kurstermine, Buchungen, Anfragen)
# Produktion/Vercel: Postgres-Verbindung, z. B. Neon über den Vercel Marketplace
# (setzt DATABASE_URL bzw. POSTGRES_URL automatisch).
DATABASE_URL=
# Lokal ohne DATABASE_URL: eingebettetes Postgres (PGlite) in diesem Ordner
DATA_DIR=./data

# Mitarbeiter-Backend: je Standort ein eigener Zugang
ADMIN_PASSWORD_MUENCHEN=bitte-aendern-muenchen
ADMIN_PASSWORD_HAMBURG=bitte-aendern-hamburg
# Langer Zufallswert zum Signieren der Sitzungen (z. B. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=

# E-Mail-Versand (Buchungsbestätigung, Kontaktanfragen). Ohne SMTP_HOST wird nur protokolliert.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Merkle Schweißkurse <info@schweisskurse-merkle.de>"
MAIL_TO_MUENCHEN=info@schweisskurse-merkle.de
MAIL_TO_HAMBURG=info@schweisskurse-merkle.de

# Zahlung
PAYPAL_ME_HANDLE=
BANK_KONTOINHABER="Wilhelm Merkle Schweißtechnik GmbH"
BANK_IBAN=
BANK_BIC=
BANK_NAME=
